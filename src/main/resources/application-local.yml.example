# 复制为 application-local.yml 后填入自己的 Key（该文件已被 .gitignore 忽略）
spring:
  datasource:
    # 本机 MySQL 的账号密码
    username: root
    password: 你的MySQL密码

  ai:
    openai:
      # DeepSeek:  https://platform.deepseek.com       base-url: https://api.deepseek.com
      # 阿里百炼:   https://bailian.console.aliyun.com  base-url: https://dashscope.aliyuncs.com/compatible-mode   model: qwen-plus
      # 智谱:      https://open.bigmodel.cn            base-url: https://open.bigmodel.cn/api/paas/v4            model: glm-4-plus
      api-key: sk-你的key
      base-url: https://api.deepseek.com
      chat:
        options:
          model: deepseek-chat
          temperature: 0.2

# Gitee 私人令牌（设置 → 私人令牌，勾选 projects 只读即可）。
# 不配也能启动，但会退化为匿名请求：60 次/小时额度，一次评审就基本用光。
# 注意：带令牌的身份只能读本账号名下的仓库，清单里的项目都要先 fork 到自己账号。
gitee:
  token: 你的Gitee私人令牌
