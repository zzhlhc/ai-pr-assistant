# 复制到服务器 /etc/ai-pr/env，填真实值，chmod 600 且属主 root。
# 语法是 systemd 的 EnvironmentFile：KEY=value，不要写 export，
# 值里如果含空格要整体加引号。
#
# 部署到本机 MySQL 时不需要覆盖 SPRING_DATASOURCE_URL ——
# application.yml 里的默认值就是 localhost:3306/ai_pr_assistant。

SPRING_PROFILES_ACTIVE=prod

# application.yml 里本地习惯开 debug，线上别开：
# 一次 agent 评审会打几十行轨迹日志，磁盘和 IO 都不划算
LOGGING_LEVEL_COM_ZHOUZI=info

# 日志目录，默认就是 /opt/ai-pr/logs（app.jar 同级），需要换位置再放开这行写绝对路径。
# 应用按天滚动：每天一个 ai-pr-assistant.log.<日期>，留 30 天、总量封顶 1G。
# LOG_DIR=/opt/ai-pr/logs

DB_USERNAME=ai_pr
DB_PASSWORD=

# DeepSeek，或任何 OpenAI 兼容服务
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Gitee 只读令牌。不配则退化为匿名（60 次/小时），一次 review 就会用光额度
GITEE_TOKEN=
